{
  "name": "dsh-plugins",
  "version": "0.0.0",
  "private": true,
  "description": "Third-party plugin collection for DeepSeek Harness (DSH)",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "scripts": {
